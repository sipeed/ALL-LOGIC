/*
 * This file is part of the libsigrokdecode4DSL project.
 *
 * It is generated from config.h.in by CMake's configure_file() at configure
 * time. The upstream autotools-based build generates it via configure, but
 * when libsigrokdecode4DSL is vendored into the top-level CMake build that
 * step is missing, so the header is produced here instead.
 */

#ifndef _LIBSIGROKDECODE4DSL_CONFIG_H
